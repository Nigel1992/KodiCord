<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>
    <category label="General">
        <setting id="enabled" type="bool" label="Enable Discord Rich Presence" default="true"/>
        <setting id="mode" type="enum" label="Connection mode" default="0" values="Local Discord client|Remote bridge (PC)"/>
        <setting id="client_id" type="text" label="Discord Application (Client) ID" default="123456789012345678"/>
        <setting id="update_interval" type="slider" label="Update interval (seconds)" default="5" range="2,1,30" option="int"/>
        <setting id="clear_on_stop" type="bool" label="Clear status when nothing is playing" default="true"/>
        <setting id="show_timestamps" type="bool" label="Show elapsed/remaining time" default="true"/>
    </category>
    <category label="Remote bridge">
        <setting id="remote_host" type="text" label="Bridge host (PC IP/hostname)" default="192.168.1.10"/>
        <setting id="remote_port" type="number" label="Bridge port" default="8765"/>
        <setting id="remote_token" type="text" label="Bridge auth token (optional)" default=""/>
        <setting id="remote_timeout" type="slider" label="HTTP timeout (seconds)" default="5" range="2,1,30" option="int"/>
    </category>
    <category label="Privacy">
        <setting id="privacy_mode" type="enum" label="What to share" default="0" values="Full title and details|Title only|Generic ('Watching a movie')"/>
        <setting id="share_filename" type="bool" label="Use filename if no metadata" default="true"/>
    </category>
    <category label="Blacklist">
        <setting id="blacklist_addons" type="text" label="Blacklisted addons (comma-separated addon ids)" default=""/>
        <setting id="manage_blacklist" type="action" label="Manage addon blacklist" action="RunScript(service.kodicord, blacklist)"/>
    </category>
    <category label="Presence">
        <setting id="presence_name_mode" type="enum" label="Presence title" default="1" values="Discord application name|Media title|Media type on Kodi|Custom text"/>
        <setting id="presence_custom_name" type="text" label="Custom presence title" default="" enable="eq(-1,3)"/>
    </category>
</settings>